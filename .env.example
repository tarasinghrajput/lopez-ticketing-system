# Local MongoDB-backed demo. npm run dev starts the database automatically.
APP_MODE=demo
DATA_STORE=mongodb
LOCAL_MONGODB=true
PORT=4000
APP_URL=http://localhost:5173
SESSION_SECRET=local-demo-session-secret-not-for-production
TICKET_SECRET=local-demo-ticket-secret-not-for-production
# For Atlas / another MongoDB service, set LOCAL_MONGODB=false and replace the URI.
# For real integrations set APP_MODE=live and replace BOTH demo secrets.
MONGODB_URI=mongodb://127.0.0.1:27018/lopez?replicaSet=lopez-rs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register APP_URL/api/v1/auth/google/callback in Google Cloud.
ADMIN_EMAILS=admin@lopez.test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Lopez Reservations <reservations@example.com>
# NODE_ENV=production
# APP_URL=https://your-restaurant.example.com
